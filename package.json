{
  "name": "job-seeker-copilot-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "config:generate": "node scripts/generate-runtime-config.mjs",
    "build": "ng build && node scripts/verify-prerender.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "ng test --watch=false",
    "test:backend": "python3 -m unittest discover -s infrastructure/waitlist-backend/tests -v",
    "test:a11y": "node scripts/accessibility-check.mjs",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.2.18",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.2.19",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.1.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "angular-eslint": "^21.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.0.0",
    "playwright": "^1.61.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.0"
  }
}
