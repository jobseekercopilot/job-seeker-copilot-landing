{
  "name": "job-seeker-copilot-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "config:generate": "node scripts/generate-runtime-config.mjs && node scripts/generate-seo-files.mjs",
    "build": "ng build && node scripts/prepare-static-not-found.mjs && node scripts/inject-csp.mjs && node scripts/verify-prerender.mjs && node scripts/verify-seo-output.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:frontend && npm run test:runtime-config && npm run test:release-policy && npm run test:seo-policy && npm run test:analytics-policy && npm run test:monitoring-policy && npm run test:security-policy && npm run test:security-gates && npm run test:operations-runbook && npm run test:e2e-runner-policy && npm run test:e2e-contact-runner-policy && npm run test:backend",
    "test:frontend": "ng test --watch=false",
    "test:runtime-config": "node scripts/runtime-config-validation.test.mjs",
    "test:release-policy": "node --test scripts/amplify-release-branch-gate.test.mjs",
    "test:seo-policy": "node --test scripts/seo-policy-validation.test.mjs",
    "test:analytics-policy": "node --test scripts/analytics-policy-validation.test.mjs",
    "test:monitoring-policy": "node --test scripts/monitoring-policy-validation.test.mjs",
    "test:security-policy": "node scripts/security-policy-validation.test.mjs",
    "test:security-gates": "node scripts/security/security-gates.test.mjs",
    "test:operations-runbook": "node scripts/operations-runbook-validation.test.mjs",
    "test:backend": "npm run test:backend:deployed && npm run test:backend:reference",
    "test:backend:deployed": "python3 -m unittest discover -s infrastructure/waitlist-backend/tests -v",
    "test:backend:reference": "python3 -m unittest discover -s infrastructure/tests -v",
    "test:a11y": "node scripts/accessibility-check.mjs",
    "test:mobile-product": "node scripts/mobile-product-check.mjs",
    "test:analytics-browser": "node scripts/analytics-browser-check.mjs",
    "test:e2e:waitlist-browser": "node scripts/waitlist-e2e-browser.mjs",
    "test:e2e-runner-policy": "node scripts/waitlist-e2e-browser-validation.test.mjs",
    "test:e2e:contact-browser": "node scripts/contact-e2e-browser.mjs",
    "test:e2e-contact-runner-policy": "node scripts/contact-e2e-browser-validation.test.mjs",
    "lint": "ng lint",
    "security:artifacts": "bash scripts/security/scan-artifacts.sh",
    "security:artifact-secret-scan": "bash scripts/security/scan-artifact-secrets.sh",
    "security:python-dependencies": "python3 scripts/security/python_dependency_policy.py",
    "security:secret-scan": "bash scripts/security/scan-history.sh",
    "security:secret-scan:test": "bash scripts/security/test-secret-scanner.sh"
  },
  "dependencies": {
    "@angular/common": "21.2.20",
    "@angular/compiler": "21.2.20",
    "@angular/core": "21.2.20",
    "@angular/forms": "21.2.20",
    "@angular/platform-browser": "21.2.20",
    "@angular/platform-server": "21.2.20",
    "@angular/router": "21.2.20",
    "@angular/ssr": "21.2.21",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.1.0",
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.20",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "angular-eslint": "^21.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.0.0",
    "playwright": "^1.61.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.0"
  }
}
