# Public browser runtime configuration. Values are written to public/config/app-config.json during a hosted build.
PUBLIC_ENVIRONMENT_NAME=production
ENABLE_LIVE_SUBMISSIONS=false
WAITLIST_API_URL=
WAITLIST_CONFIRMATION_API_URL=
WAITLIST_RESEND_API_URL=
WAITLIST_UNSUBSCRIBE_API_URL=
CONTACT_API_URL=
MAIN_APPLICATION_URL=
REGISTRATION_URL=
SIGN_IN_URL=
PRICING_URL=
PUBLIC_WEBSITE_URL=
PRIVACY_POLICY_URL=/privacy
TERMS_URL=/terms
SUPPORT_URL=/contact
ANALYTICS_ID=
ANTI_BOT_PROVIDER=none
ANTI_BOT_SITE_KEY=
CONSENT_VERSION=
MINIMUM_FORM_COMPLETION_MS=1200
CONTACT_MESSAGE_MAX_LENGTH=3000
COPYRIGHT_NOTICE=Job Seeker Copilot

# Backend deployment parameters. Supply these to SAM; do not copy them into browser config.
SES_REGION=eu-west-2
WAITLIST_SENDER_EMAIL=updates@jobseekercopilot.com
PUBLIC_SUPPORT_EMAIL=support@jobseekercopilot.com
PUBLIC_SITE_URL=
SES_CONFIGURATION_SET=JobSeekerCopilotWaitlistEmails
CONFIRMATION_TOKEN_TTL_SECONDS=172800
CONFIRMATION_RESEND_COOLDOWN_SECONDS=900
MAX_CONFIRMATION_SENDS=5
CONFIRMATION_SEND_WINDOW_SECONDS=86400
PENDING_RETENTION_SECONDS=2592000
ENABLE_CONTACT_SUBMISSIONS=false
CONTACT_SENDER_EMAIL=hello@jobseekercopilot.com
CONTACT_RECIPIENT_EMAIL=
